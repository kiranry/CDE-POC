DATABASE_URL="postgresql://prhub:prhub@localhost:5432/prhub_cde"
AUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# local | s3
STORAGE_MODE="local"
LOCAL_STORAGE_PATH="./storage/uploads"

S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="prhub-cde"

# RFI email (optional — without SMTP, emails are logged to the server console)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="PRHUB CDE <noreply@prhub.local>"

# Overdue RFI auto-email (7-day deadline)
ENABLE_RFI_OVERDUE_CRON="true"
CRON_SECRET="change-me-cron-secret"

# --- Plan B (Vercel + Neon + R2): see .env.plan-b.example and DEPLOYMENT-PLAN-B.md ---
# S3_FORCE_PATH_STYLE="false"   # required for Cloudflare R2
