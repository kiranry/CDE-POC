# Plan B — Vercel + Neon + Cloudflare R2 (copy into Vercel Environment Variables)
# Run db push + seed from your laptop once (see DEPLOYMENT-PLAN-B.md)

# Neon Postgres (use pooled URL for Vercel — hostname contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth — NEXTAUTH_URL must match your live URL exactly (no trailing slash)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-project.vercel.app"

# Cloudflare R2 (required on Vercel — local storage does not work)
STORAGE_MODE="s3"
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY="your-r2-access-key-id"
S3_SECRET_KEY="your-r2-secret-access-key"
S3_BUCKET="prhub-cde"
S3_FORCE_PATH_STYLE="false"

# Email — Brevo free tier (https://www.brevo.com)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-login-email"
SMTP_PASS="your-brevo-smtp-key"
MAIL_FROM="PRHUB CDE <noreply@yourdomain.com>"

# Overdue RFI — use cron-job.org, not in-app timer
CRON_SECRET="generate-with-openssl-rand-base64-32"
ENABLE_RFI_OVERDUE_CRON="false"
